# PostgreSQL principal
POSTGRES_DB=vehicle_billing
POSTGRES_USER=gbastos_user
POSTGRES_PASSWORD=change_me

# Connection string principal usada pela API e pelo Worker
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=vehicle_billing;Username=gbastos_user;Password=change_me

# Connection string exclusiva para testes automatizados
VEHICLE_BILLING_TEST_CONNECTION_STRING=Host=localhost;Port=5434;Database=vehicle_billing_test;Username=gbastos_user;Password=change_me

# RabbitMQ
RABBITMQ_DEFAULT_USER=change_me
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_USER=change_me
RABBITMQ_PASSWORD=change_me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/vehicle_billing
